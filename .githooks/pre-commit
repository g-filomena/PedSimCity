#!/bin/sh
# Guard against committing a Git-LFS-tracked file (e.g. *.gpkg) as a raw binary
# instead of a pointer. This catches the "git lfs not installed" mistake that
# silently bloats history with large binaries (see the Torino_*.gpkg incident).
#
# Install (once per clone):
#   git lfs install
#   cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Do NOT wire this via core.hooksPath — that would disable Git LFS's own hooks.

fail=0

# Newly added or modified files staged for this commit.
for f in $(git diff --cached --name-only --diff-filter=AM); do
    # Only files Git is meant to route through the LFS filter.
    attr=$(git check-attr filter -- "$f" 2>/dev/null | sed 's/.*: //')
    [ "$attr" = "lfs" ] || continue

    # The staged blob must be an LFS pointer, not raw file content.
    first=$(git cat-file -p ":$f" 2>/dev/null | head -c 45)
    case "$first" in
        "version https://git-lfs.github.com/spec/v1"*) : ;;  # ok: pointer
        *)
            echo "ERROR: '$f' is LFS-tracked but staged as a raw file, not a Git LFS pointer."
            fail=1
            ;;
    esac
done

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "Fix: run 'git lfs install', then re-stage the file(s) above. Commit aborted."
    exit 1
fi

# ---------------------------------------------------------------------------
# Formatting: fix it here, so it is never pushed wrong and CI never fails on it.
#
# At commit time rather than push time on purpose. A pre-push hook can only stop
# you - the commits it is about to push already contain the unformatted code, so
# it has to abort and ask you to commit the fix. Doing it here means the commit
# is formatted in the first place and nothing downstream has anything to say.
#
# Only files already staged are re-staged. Spotless formats the whole tree, and
# sweeping files you had not staged into the commit would be worse than the
# problem being solved. A staged file that also has unstaged edits is the one
# case that still merges them - rare, and git warns you in the commit diff.
#
# Skip with `git commit --no-verify`, or SKIP_SPOTLESS=1.
# ---------------------------------------------------------------------------

staged_java=$(git diff --cached --name-only --diff-filter=ACM -- '*.java')

if [ -n "$staged_java" ] && [ -z "$SKIP_SPOTLESS" ] && command -v mvn >/dev/null 2>&1; then
    printf 'pre-commit: formatting staged Java (spotless)... '
    log=$(mktemp 2>/dev/null || echo /tmp/spotless-pre-commit.log)

    if mvn -q spotless:apply < /dev/null > "$log" 2>&1; then
        restaged=""
        for f in $staged_java; do
            # Skip anything deleted between staging and now.
            [ -f "$f" ] || continue
            if ! git diff --quiet -- "$f"; then
                git add -- "$f"
                restaged="$restaged $f"
            fi
        done
        if [ -n "$restaged" ]; then
            printf 'reformatted and re-staged:
'
            for f in $restaged; do echo "  $f"; done
        else
            printf 'already clean
'
        fi
    else
        printf 'FAILED
'
        echo "spotless:apply failed; committing unformatted. Output:"
        tail -20 "$log"
    fi
    rm -f "$log"
fi

exit 0
