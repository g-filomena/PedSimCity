root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{xml,pom,html,css,js,json,yml,yaml,md,py}]
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
